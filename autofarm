local hooks = {
    InputUpdate = nil,
    SetState    = nil,
    BeginShot   = nil,
    Legal       = nil,
}
local captured = { Input = nil, Rules = nil, InputAt = 0, RulesAt = 0 }

local function installHooks()
    if PoolInputController.Update and hooks.InputUpdate == nil then
        hooks.InputUpdate = PoolInputController.Update
        PoolInputController.Update = function(y, z, ...)
            captured.Input = y
            captured.InputAt = os.clock()
            return hooks.InputUpdate(y, z, ...)
        end
    end
    if PoolInputController.SetState and hooks.SetState == nil then
        hooks.SetState = PoolInputController.SetState
        PoolInputController.SetState = function(y, z, ...)
            captured.Input = y
            captured.InputAt = os.clock()
            return hooks.SetState(y, z, ...)
        end
    end
    if PoolRules.BeginShot and hooks.BeginShot == nil then
        hooks.BeginShot = PoolRules.BeginShot
        PoolRules.BeginShot = function(y, z, ...)
            captured.Rules = y
            captured.RulesAt = os.clock()
            return hooks.BeginShot(y, z, ...)
        end
    end
    if PoolRules.IsLegalFirstContact and hooks.Legal == nil then
        hooks.Legal = PoolRules.IsLegalFirstContact
        PoolRules.IsLegalFirstContact = function(y, z, A, ...)
            captured.Rules = y
            captured.RulesAt = os.clock()
            return hooks.Legal(y, z, A, ...)
        end
    end
end

local function uninstallHooks()
    if hooks.SetState    ~= nil and PoolInputController then PoolInputController.SetState    = hooks.SetState    end
    if hooks.InputUpdate ~= nil and PoolInputController then PoolInputController.Update      = hooks.InputUpdate end
    if hooks.BeginShot   ~= nil and PoolRules           then PoolRules.BeginShot             = hooks.BeginShot   end
    if hooks.Legal       ~= nil and PoolRules           then PoolRules.IsLegalFirstContact   = hooks.Legal       end
    hooks.InputUpdate = nil
    hooks.SetState    = nil
    hooks.BeginShot   = nil
    hooks.Legal       = nil
end

installHooks()

local pockets = {}
do
    local ok, data = pcall(PoolGeometry.GetPockets)
    if ok and type(data) == "table" then
        for _, pkt in pairs(data) do
            if type(pkt) == "table" then
                local mouth = pkt.MouthCentre or pkt.Centre or pkt.Position or Vector2.zero
                local bowl  = pkt.BowlCentre or mouth
                local norm  = pkt.Normal
                pockets[#pockets + 1] = {
                    Id           = pkt.Id,
                    VisualCentre = mouth:Lerp(bowl, 0.22),
                    BowlCentre   = bowl,
                    MouthCentre  = mouth,
                    Normal       = (norm and typeof(norm) == "Vector2") and norm or Vector2.zero,
                    Radius       = 2.1,
                }
            end
        end
    end
end

local function getCue(sim)
    return sim and sim.Balls and sim.Balls[PoolConstants.CueBallNumber]
end

local function isActive(ball)
    return ball and not ball.Pocketed and not ball.Sinking
end

local function mySeat()
    local ok, state = pcall(function()
        return PoolMatchReplica and PoolMatchReplica.GetState and PoolMatchReplica.GetState()
    end)
    if not ok or not state then return nil, nil end
    if PoolMatchTypes and PoolMatchTypes.SeatOf then
        local sOk, seat = pcall(PoolMatchTypes.SeatOf, state, LocalPlayer.UserId)
        if sOk and seat then return seat, state end
    end
    if state.Seats then
        if state.Seats[1] == LocalPlayer.UserId then return 1, state end
        if state.Seats[2] == LocalPlayer.UserId then return 2, state end
    end
    if state.Players then
        for k, v in pairs(state.Players) do
            local uid = (type(v) == "table" and (v.UserId or v.Id)) or v
            if uid == LocalPlayer.UserId then return k, state end
        end
    end
    return nil, nil
end

local function isMyTurn()
    local seat, state = mySeat()
    if not seat or not state or state.Phase ~= "Playing" then return false end
    return state.Turn == seat, state, seat
end

local function getMyGroup()
    if Config.GroupOverride == "Solid"  then return "Solid"  end
    if Config.GroupOverride == "Stripe" then return "Stripe" end
    local seat, state = mySeat()
    if seat then
        if state and state.Groups and state.Groups[seat] then return state.Groups[seat] end
        if captured.Rules and captured.Rules.Groups and captured.Rules.Groups[seat] then return captured.Rules.Groups[seat] end
        local hud = captured.Input and captured.Input.Hud
        if hud and hud.Groups and hud.Groups[seat] then return hud.Groups[seat] end
    end
    return nil
end

local function isBreak()
    local sim = captured.Input and captured.Input.Simulation
    local _, state = mySeat()
    return (captured.Rules and captured.Rules.Phase == "Break")
        or (state and state.RulesPhase == "Break")
        or (state and state.Phase == "Break")
        or (sim and sim.IsBreakShot)
end

local function isLegalFirst(ballNum)
    if not ballNum or ballNum == PoolConstants.CueBallNumber then return false end
    if isBreak() then return true end
    local group = getMyGroup()
    if not group then return ballNum ~= 8 end
    local sim = captured.Input and captured.Input.Simulation
    local remaining = 0
    if sim and sim.Balls then
        local lo = (group == "Solid" and 1 or 9)
        local hi = (group == "Solid" and 7 or 15)
        for i = lo, hi do
            if isActive(sim.Balls[i]) then remaining += 1 end
        end
    end
    if remaining == 0 then return ballNum == 8 end
    if ballNum == 8    then return false       end
    if group == "Solid"  then return ballNum >= 1 and ballNum <= 7  end
    if group == "Stripe" then return ballNum >= 9 and ballNum <= 15 end
    return false
end

local function getTargets(sim)
    local targets = {}
    for i = 1, 15 do
        local ball = sim.Balls[i]
        if isActive(ball) and isLegalFirst(i) then
            targets[#targets + 1] = ball
        end
    end
    local group = getMyGroup()
    local label = "Open Table"
    if group == "Solid" then
        label = (#targets == 1 and targets[1].Number == 8) and "8-Ball" or "Solids"
    elseif group == "Stripe" then
        label = (#targets == 1 and targets[1].Number == 8) and "8-Ball" or "Stripes"
    end
    return targets, label
end

local function matchOver(state)
    if not state then return true end
    local w = state.Winner
    if w ~= nil and w ~= false and w ~= 0 then return true end
    return state.GameOver == true
        or state.IsOver == true
        or state.Over == true
        or state.MatchOver == true
        or state.Finished == true
end

local function isInGame()
    local _seat, matchState = mySeat()
    if matchState then
        local phase = matchState.Phase
        if phase == "Playing" or phase == "Break" then
            return not matchOver(matchState)
        end
        return false
    end
    local input = captured.Input
    if input and (os.clock() - captured.InputAt) < 1.0 then
        local sim = input.Simulation
        if sim and sim.Balls then
            local cue = sim.Balls[PoolConstants.CueBallNumber]
            if cue and isActive(cue) then
                local state = input.State
                if state == "Aiming" or state == "Charging" or state == "BallInHand" then
                    return true
                end
            end
        end
    end
    return false
end

local function pathBlocked(sim, ball, from, to)
    local order = sim.Order
    if not order then return false end
    local seg     = to - from
    local segLen2 = seg:Dot(seg)
    for _, idx in ipairs(order) do
        local other = sim.Balls[idx]
        if other and other ~= ball and isActive(other) and other.Number ~= PoolConstants.CueBallNumber then
            local dist
            if segLen2 < 1e-6 then
                dist = (other.Position - from).Magnitude
            else
                local t = math.clamp((other.Position - from):Dot(seg) / segLen2, 0, 1)
                dist = (other.Position - (from + seg * t)).Magnitude
            end
            if dist < PoolConstants.BallDiameter + 0.05 then return true end
        end
    end
    return false
end

local function cuePathBlocked(sim, cuePos, ghost)
    local seg     = ghost - cuePos
    local segLen2 = seg:Dot(seg)
    local order   = sim.Order
    if not order then return false end
    for _, idx in ipairs(order) do
        local other = sim.Balls[idx]
        if other and isActive(other) and other.Number ~= PoolConstants.CueBallNumber then
            local dist
            if segLen2 < 1e-6 then
                dist = (other.Position - cuePos).Magnitude
            else
                local t = math.clamp((other.Position - cuePos):Dot(seg) / segLen2, 0, 1)
                dist = (other.Position - (cuePos + seg * t)).Magnitude
            end
            if dist < PoolConstants.BallDiameter + 0.05 then return true end
        end
    end
    return false
end

local function simulate(sim, dir, power, spin, targetBall)
    if not (PoolStepper and PoolStepper.RunToSettle
        and PoolPhysics.Clone and PoolPhysics.Shoot) then
        return nil
    end
    local ok, clone = pcall(PoolPhysics.Clone, sim)
    if not (ok and clone) then return nil end
    if not pcall(PoolPhysics.Shoot, clone, dir, power, spin or Vector2.zero) then return nil end
    if not pcall(PoolStepper.RunToSettle, clone) then return nil end

    local cueAfter  = clone.Balls[PoolConstants.CueBallNumber]
    local cuePotted = not cueAfter or cueAfter.Pocketed or cueAfter.Sinking

    local targetPotted = false
    if targetBall then
        local t = clone.Balls[targetBall.Number]
        if t and (t.Pocketed or t.Sinking) then targetPotted = true end
    end

    local eightPotted = false
    local eight = clone.Balls[8]
    if eight and (eight.Pocketed or eight.Sinking) then eightPotted = true end

    local myPotted = 0
    for i = 1, 15 do
        if isLegalFirst(i) then
            local before = sim.Balls[i]
            local after  = clone.Balls[i]
            if before and isActive(before) and after and (after.Pocketed or after.Sinking) then
                myPotted += 1
            end
        end
    end

    local leaveScore = 0
    if not cuePotted and cueAfter then
        local cuePos     = cueAfter.Position
        local bestLeave  = 0
        local countOther = 0
        for i = 1, 15 do
            local b = clone.Balls[i]
            if b and not b.Pocketed and not b.Sinking and isLegalFirst(i) then
                if targetBall and i == targetBall.Number then continue end
                countOther += 1
                local bestAlign = 0
                for _, pkt in ipairs(pockets) do
                    local toPkt = pkt.MouthCentre - b.Position
                    if toPkt.Magnitude > 0.5 then
                        local pktDir  = toPkt.Unit
                        local ghostP  = b.Position - pktDir * PoolConstants.BallDiameter
                        local toGhost = ghostP - cuePos
                        if toGhost.Magnitude > 0.5 then
                            local align = toGhost.Unit:Dot(pktDir)
                            if align > bestAlign then bestAlign = align end
                        end
                    end
                end
                local distFactor = 1 - math.clamp(math.abs((b.Position - cuePos).Magnitude - 18) / 40, 0, 1)
                local score = distFactor * 0.35 + math.clamp(bestAlign, 0, 1) * 0.65
                if score > bestLeave then bestLeave = score end
            end
        end
        if countOther == 0 then
            bestLeave = 1 - math.clamp((math.abs(cuePos.X) + math.abs(cuePos.Y)) / 60, 0, 1)
        end
        leaveScore = bestLeave
    end

    return {
        TargetPotted = targetPotted,
        CuePotted    = cuePotted,
        EightPotted  = eightPotted,
        MyPotted     = myPotted,
        LeaveScore   = leaveScore,
        CueRest      = (not cuePotted and cueAfter) and cueAfter.Position or nil,
    }
end

local Solver = { best = nil, bestKey = nil, solving = false, makeable = 0, total = 0, lastError = nil }
local POWER_LEVELS = { 0.50, 0.75, 1.00 }
local TOP_N = 6

local function powerLabel(p)
    if p < 0.55 then return "SOFT"
    elseif p < 0.68 then return "CTRL"
    elseif p < 0.82 then return "MED"
    elseif p < 0.95 then return "HARD" end
    return "MAX"
end

function Solver.compute(force)
    if Solver.solving then return Solver.best end
    local input = captured.Input
    local sim   = input and input.Simulation
    if not sim then return nil end
    local cue = getCue(sim)
    if not (cue and isActive(cue) and sim.Settled) then return nil end

    local _seat, state = mySeat()
    local cacheKey = (state and state.ShotIndex or 0)
        .. ":" .. math.floor(cue.Position.X * 4)
        .. ":" .. math.floor(cue.Position.Y * 4)
    if not force and Solver.bestKey == cacheKey and Solver.best then return Solver.best end

    Solver.solving   = true
    Solver.lastError = nil

    local ok, err = pcall(function()
        if isBreak() then
            local closest, closestBall = math.huge, nil
            for i = 1, 15 do
                local b = sim.Balls[i]
                if isActive(b) then
                    local d = (b.Position - cue.Position).Magnitude
                    if d < closest then closest = d; closestBall = b end
                end
            end
            if closestBall then
                local dir = (closestBall.Position - cue.Position).Unit
                Solver.best = {
                    Dir = dir, Power = 1.0, Ball = closestBall, Pocket = nil,
                    Ghost = closestBall.Position - dir * PoolConstants.BallDiameter,
                    CosCut = 1.0, Score = 99999, Scratch = false, Dist = closest,
                    Kind = "BREAK", PowerLabel = "MAX",
                }
                Solver.bestKey = cacheKey
                return
            end
        end

        local targets, kindLabel = getTargets(sim)
        local spin = (input.Hud and input.Hud.Spin) or Vector2.zero

        local candidates = {}
        for _, tgt in ipairs(targets) do
            for _, pkt in ipairs(pockets) do
                local toPkt   = pkt.MouthCentre - tgt.Position
                local pktDist = toPkt.Magnitude
                if pktDist < 0.5 then continue end
                local pktDir = toPkt.Unit
                if pkt.Normal.Magnitude > 0.01 and pktDir:Dot(pkt.Normal) < 0.12 then continue end
                local ghost   = tgt.Position - pktDir * PoolConstants.BallDiameter
                local toGhost = ghost - cue.Position
                local cueDist = toGhost.Magnitude
                if cueDist < 0.5 then continue end
                local cueDir = toGhost.Unit
                local cosCut = cueDir:Dot(pktDir)
                if cosCut < 0.22 then continue end
                local blocked    = pathBlocked(sim, tgt, tgt.Position, pkt.MouthCentre)
                local cueBlocked = cuePathBlocked(sim, cue.Position, ghost)
                if blocked then continue end
                local geoScore = cosCut * 5
                    + (1 - math.clamp(pktDist / (PoolConstants.PlayWidth * 0.9), 0, 1)) * 2
                    + (1 - math.clamp(cueDist / (PoolConstants.PlayWidth * 0.9), 0, 1)) * 1
                if cueBlocked then geoScore -= 3 end
                if tgt.Number == 8 then geoScore += 10 end
                candidates[#candidates + 1] = {
                    Dir = cueDir, Ball = tgt, Pocket = pkt, Ghost = ghost,
                    CosCut = cosCut, GeoScore = geoScore, Dist = cueDist, BpDist = pktDist,
                }
            end
        end

        table.sort(candidates, function(a, b) return a.GeoScore > b.GeoScore end)
        local topN = math.min(#candidates, TOP_N)

        local results = {}
        for i = 1, topN do
            local c = candidates[i]
            local bestPower, bestScore, bestSim = 1.0, -math.huge, nil
            for _, pwr in ipairs(POWER_LEVELS) do
                local res = simulate(sim, c.Dir, pwr, spin, c.Ball)
                if res then
                    local score = 0
                    if res.CuePotted then
                        score = -99999
                    elseif res.EightPotted and c.Ball.Number ~= 8 then
                        score = -99999
                    elseif res.TargetPotted then
                        score = 1000 + res.LeaveScore * 250 + res.MyPotted * 180
                        if c.Ball.Number == 8 then score += 5000 end
                        score += (1 - pwr) * 8
                    else
                        score = -40 + res.LeaveScore * 15
                    end
                    if score > bestScore then
                        bestScore = score; bestPower = pwr; bestSim = res
                    end
                end
            end
            if not bestSim then bestScore = c.GeoScore; bestPower = 1.0 end
            local finalScore = bestScore + c.CosCut * 3
                + (1 - math.clamp(c.BpDist / (PoolConstants.PlayWidth * 0.9), 0, 1))
            results[#results + 1] = {
                Dir = c.Dir, Power = bestPower, Ball = c.Ball, Pocket = c.Pocket,
                Ghost = c.Ghost, CosCut = c.CosCut, Score = finalScore,
                Scratch = bestSim and bestSim.CuePotted or false,
                Dist = c.Dist, Kind = kindLabel, PowerLabel = powerLabel(bestPower),
                SimResult = bestSim,
            }
        end

        for i = topN + 1, math.min(#candidates, 20) do
            local c = candidates[i]
            results[#results + 1] = {
                Dir = c.Dir, Power = 1.0, Ball = c.Ball, Pocket = c.Pocket,
                Ghost = c.Ghost, CosCut = c.CosCut, Score = c.GeoScore - 500,
                Scratch = false, Dist = c.Dist, Kind = kindLabel,
                PowerLabel = "MAX", SimResult = nil,
            }
        end

        local hasGoodShot = false
        for _, r in ipairs(results) do
            if r.Score > 500 then hasGoodShot = true; break end
        end
        if not hasGoodShot and #targets >= 2 then
            local comboCount = 0
            for _, t1 in ipairs(targets) do
                if comboCount >= 6 then break end
                if (t1.Position - cue.Position).Magnitude < 0.5 then continue end
                for _, t2 in ipairs(targets) do
                    if t2 == t1 then continue end
                    if comboCount >= 6 then break end
                    for _, pkt in ipairs(pockets) do
                        if comboCount >= 6 then break end
                        local toPkt = pkt.MouthCentre - t2.Position
                        if toPkt.Magnitude < 0.5 then continue end
                        local pktDir  = toPkt.Unit
                        local ghost2  = t2.Position - pktDir * PoolConstants.BallDiameter
                        local t2Vec   = ghost2 - t1.Position
                        if t2Vec.Magnitude < 0.5 then continue end
                        local t2Dir = t2Vec.Unit
                        local cueGhost = t1.Position - t2Dir * PoolConstants.BallDiameter
                        local toCG     = cueGhost - cue.Position
                        if toCG.Magnitude < 0.5 then continue end
                        local cueDir = toCG.Unit
                        if cueDir:Dot(t2Dir) < 0.3 or t2Dir:Dot(pktDir) < 0.3 then continue end
                        comboCount += 1
                        local res = simulate(sim, cueDir, 1.0, spin, t2)
                        if res and res.TargetPotted and not res.CuePotted then
                            local score = 600 + res.LeaveScore * 80
                            if res.EightPotted and t2.Number ~= 8 then score = -99999 end
                            results[#results + 1] = {
                                Dir = cueDir, Power = 1.0, Ball = t2, Pocket = pkt,
                                Ghost = cueGhost, CosCut = cueDir:Dot(t2Dir), Score = score,
                                Scratch = false, Dist = toCG.Magnitude,
                                Kind = "Combo", PowerLabel = "MAX", SimResult = res,
                            }
                        end
                    end
                end
            end
        end

        Solver.total    = #targets * math.max(#pockets, 1)
        Solver.makeable = #results
        table.sort(results, function(a, b) return a.Score > b.Score end)

        if #results > 0 and results[1].Score > -500 then
            Solver.best = results[1]
        else
            local bestSafScore, bestSaf = -math.huge, nil
            for _, tgt in ipairs(targets) do
                local dir = tgt.Position - cue.Position
                if dir.Magnitude < 0.5 then continue end
                dir = dir.Unit
                local res = simulate(sim, dir, 0.30, spin, tgt)
                if res then
                    local score = 0
                    if res.CuePotted then
                        score = -99999
                    elseif res.EightPotted then
                        score = -99999
                    elseif res.CueRest then
                        local nearest = math.huge
                        local group   = getMyGroup()
                        local lo, hi  = 1, 15
                        if group == "Solid"   then lo, hi = 9, 15
                        elseif group == "Stripe" then lo, hi = 1, 7 end
                        for i = lo, hi do
                            local b = sim.Balls[i]
                            if b and isActive(b) then
                                local d = (b.Position - res.CueRest).Magnitude
                                if d < nearest then nearest = d end
                            end
                        end
                        score = math.clamp(nearest / 40, 0, 1) * 50
                        local halfW = PoolConstants.PlayWidth  / 2
                        local halfH = PoolConstants.PlayHeight / 2
                        local wallDist = math.min(
                            math.abs(res.CueRest.X - halfW), math.abs(res.CueRest.X + halfW),
                            math.abs(res.CueRest.Y - halfH), math.abs(res.CueRest.Y + halfH)
                        )
                        if wallDist < 5 then score += 15 end
                    else
                        score = -(tgt.Position - cue.Position).Magnitude * 0.5
                    end
                    if score > bestSafScore then
                        bestSafScore = score
                        bestSaf = {
                            Dir = dir, Power = 0.30, Ball = tgt, Pocket = nil,
                            Ghost = tgt.Position - dir * PoolConstants.BallDiameter,
                            CosCut = 0.5, Score = score, Kind = "Safety",
                            Scratch = res.CuePotted or false, PowerLabel = "SOFT",
                            SimResult = res,
                        }
                    end
                end
            end
            Solver.best = bestSaf
        end
        Solver.bestKey = cacheKey
    end)

    if not ok then Solver.lastError = tostring(err) end
    Solver.solving = false
    return Solver.best
end

local aimAnim = nil
local function aimAnimating() return aimAnim ~= nil end

local function aimSmooth(dir, dur)
    local input = captured.Input
    if not input then return false end
    local cur = input.Direction
    if not cur or cur.Magnitude < 1e-4 then input.Direction = dir; return true end
    cur = cur.Unit
    local target = dir.Unit
    local dot    = math.clamp(cur:Dot(target), -1, 1)
    local angle  = math.acos(dot)
    if angle < 1e-4 then input.Direction = target; return true end
    aimAnim = {
        base  = math.atan2(cur.Y, cur.X),
        turn  = (cur.X * target.Y - cur.Y * target.X) >= 0 and 1 or -1,
        total = angle, t0 = os.clock(), dur = math.max(dur or 0.28, 0.06),
    }
    input.AimLocked = true
    return true
end

local function canShoot()
    local input = captured.Input
    if not input then return false, "No match" end
    local state = input.State
    if state ~= "Aiming" and state ~= "Charging" and state ~= "BallInHand" then
        return false, "Not aiming"
    end
    if not isMyTurn() then return false, "Not your turn" end
    return true
end

local function releaseAim()
    local input = captured.Input
    if not input then return end
    input.AimLocked = false
    input.AimAnchor = nil
end

local function fire(dir, power)
    local input = captured.Input
    if not input or not input.ShotBindable then return false, "no input" end
    local ok, msg = canShoot()
    if not ok then return false, msg end
    if not getCue(input.Simulation) then return false, "no cue" end
    local spin = (input.Hud and input.Hud.Spin) or Vector2.zero
    input.Power = 0
    input.CanPlaceCueBall = false
    if PoolHudRenderer and PoolHudRenderer.SetPower and input.Hud then
        pcall(PoolHudRenderer.SetPower, input.Hud, 0)
    end
    input.ShotBindable:Fire(dir, math.clamp(power, 0, 1), spin)
    return true
end

local function placeBest()
    local input = captured.Input
    if not input or input.State ~= "BallInHand" then return false, "No BIH" end
    local sim = input.Simulation
    local cue = getCue(sim)
    if not cue then return false, "No cue" end
    local pw, ph = PoolConstants.PlayWidth, PoolConstants.PlayHeight
    local br     = PoolConstants.BallRadius + 0.3
    local behindHead = (captured.Rules and captured.Rules.BehindHeadString) or false
    local xMin, xMax = -pw / 2 + br, pw / 2 - br
    local yMin, yMax = -ph / 2 + br, ph / 2 - br
    if behindHead then
        local ok, spot = pcall(function() return PoolGeometry.BreakSpot end)
        if ok and typeof(spot) == "Vector2" then
            local sign  = spot.Y >= 0 and 1 or -1
            local edge  = sign * (ph / 2 - br)
            local quart = sign * (ph / 4)
            yMin, yMax = math.min(edge, quart), math.max(edge, quart)
        end
    end
    local bestScore, bestPos = -math.huge, nil
    local targetsList = getTargets(sim)
    for x = xMin, xMax, 2.5 do
        for y = yMin, yMax, 2.5 do
            local pos   = Vector2.new(x, y)
            local clear = true
            local order = sim.Order
            if order then
                for _, idx in ipairs(order) do
                    local b = sim.Balls[idx]
                    if b and b ~= cue and isActive(b)
                        and (b.Position - pos).Magnitude < PoolConstants.BallDiameter + 0.1 then
                        clear = false; break
                    end
                end
            end
            if clear then
                local score = -((x * x + y * y) * 1e-4)
                for _, tgt in ipairs(targetsList) do
                    for _, pkt in ipairs(pockets) do
                        local toPkt = pkt.MouthCentre - tgt.Position
                        if toPkt.Magnitude > 0.5 then
                            local pktDir  = toPkt.Unit
                            local ghost   = tgt.Position - pktDir * PoolConstants.BallDiameter
                            local toGhost = ghost - pos
                            if toGhost.Magnitude > 0.5 then
                                local align = toGhost.Unit:Dot(pktDir)
                                if align > 0.45
                                    and not pathBlocked(sim, tgt, tgt.Position, pkt.MouthCentre) then
                                    score += align * 3
                                end
                            end
                        end
                    end
                end
                if score > bestScore then bestScore = score; bestPos = pos end
            end
        end
    end
    if not bestPos then return false, "No spot" end
    cue.Position = bestPos
    local view = input.View
    if view and LibRoot:FindFirstChild("PoolViewController") then
        local ok, ctrl = pcall(require, LibRoot.PoolViewController)
        if ok and ctrl and ctrl.SetBall then
            pcall(ctrl.SetBall, view, PoolConstants.CueBallNumber, bestPos)
        end
    end
    return true
end

local function setSpin(preset)
    local input = captured.Input
    if not (input and input.Hud) then return end
    local spin = Vector2.zero
    if     preset == "Follow" then spin = Vector2.new(0, 0.7)
    elseif preset == "Draw"   then spin = Vector2.new(0, -0.7)
    elseif preset == "Left"   then spin = Vector2.new(-0.7, 0)
    elseif preset == "Right"  then spin = Vector2.new(0.7, 0) end
    Config.SpinPreset = preset
    if PoolHudRenderer and PoolHudRenderer.SetSpin then
        pcall(PoolHudRenderer.SetSpin, input.Hud, spin)
    end
end

local poolRemoteCache = nil
local function isRemote(inst)
    return inst and (inst:IsA("RemoteEvent")
        or inst:IsA("RemoteFunction")
        or inst:IsA("UnreliableRemoteEvent"))
end

local function getPoolRemote()
    if poolRemoteCache and poolRemoteCache.Parent then return poolRemoteCache end
    poolRemoteCache = nil

    local remotes = RepStorage:FindFirstChild("Remotes")
    if remotes then
        local pool = remotes:FindFirstChild("Pool")
        if isRemote(pool) then poolRemoteCache = pool; return pool end
    end

    local direct = RepStorage:FindFirstChild("Pool")
    if isRemote(direct) then poolRemoteCache = direct; return direct end

    for _, inst in ipairs(RepStorage:GetDescendants()) do
        if isRemote(inst) and inst.Name:find("Pool") then
            poolRemoteCache = inst
            return inst
        end
    end
    return nil
end

local function fireRemote(remote, ...)
    local args = table.pack(...)
    if remote:IsA("RemoteFunction") then
        return pcall(function() return remote:InvokeServer(table.unpack(args, 1, args.n)) end)
    end
    return pcall(function() return remote:FireServer(table.unpack(args, 1, args.n)) end)
end

local venueTrackCache = nil
local function getVenueTrack()
    if venueTrackCache and venueTrackCache.Parent then return venueTrackCache end
    venueTrackCache = nil
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local menu = pg and pg:FindFirstChild("PoolMenuUI")
    local venueMenu = menu and menu:FindFirstChild("VenueMenu")
    local track = venueMenu and venueMenu:FindFirstChild("Track")
    if track then venueTrackCache = track end
    return track
end

local function parsePrize(text)
    if type(text) ~= "string" then return nil end
    local numStr, suffix = text:match("(%d[%d,%.]*)%s*([KkMmBb]?)")
    if not numStr then return nil end
    local n = tonumber((numStr:gsub(",", "")))
    if not n or n <= 0 then return nil end
    local mul = 1
    suffix = (suffix or ""):upper()
    if suffix == "K" then mul = 1e3
    elseif suffix == "M" then mul = 1e6
    elseif suffix == "B" then mul = 1e9 end
    return n * mul
end

local function ringUnlocked(ring)
    if type(ring) ~= "string" then return nil end
    local upper = ring:upper()
    if upper == "" then return nil end
    local hasUnlockedWord = upper:find("UNLOCKED") ~= nil
    local stripped = upper:gsub("UNLOCKED", "")
    if stripped:find("LOCKED") then return false end
    if hasUnlockedWord or upper:find("UNLOCK THE NEXT") then return true end
    return nil
end

local function scanVenues()
    local track = getVenueTrack()
    if not track then return nil end
    local list = {}
    for _, v in ipairs(track:GetChildren()) do
        if v:IsA("GuiButton") then
            local prizeLbl = v:FindFirstChild("Prize", true)
            local ringLbl  = v:FindFirstChild("Ring", true)
            local prize    = prizeLbl and parsePrize(prizeLbl.Text) or nil
            if prize then
                list[#list + 1] = {
                    Name     = v.Name,
                    Prize    = prize,
                    Unlocked = ringLbl and ringUnlocked(ringLbl.Text) or nil,
                    Ring     = ringLbl and ringLbl.Text or "",
                }
            end
        end
    end
    if #list == 0 then return nil end
    return list
end

local function selectBestVenue()
    local list = scanVenues()
    if not list then return nil end
    local best, bestPrize, unlockedCount = nil, -math.huge, 0
    for _, e in ipairs(list) do
        if e.Unlocked == true then
            unlockedCount += 1
            if e.Prize > bestPrize then
                bestPrize = e.Prize
                best = e
            end
        end
    end
    if unlockedCount == 0 or not best then return nil end
    return best.Name
end

local function bestRegion()
    if not Config.AutoVenue then return Config.QueueRegion end
    local first = selectBestVenue()
    if not first then return Config.VenueFallback or Config.QueueRegion end
    task.wait(0.15)
    local second = selectBestVenue()
    if second ~= first then return Config.VenueFallback or Config.QueueRegion end
    return first
end

local function sendQueue()
    local remote = getPoolRemote()
    if not remote then return false end
    return fireRemote(remote, "Queue", bestRegion())
end

local function sendRematch()
    local remote = getPoolRemote()
    if not remote then return false end
    return fireRemote(remote, "Rematch")
end

local function sendPickCard()
    local remote = getPoolRemote()
    if not remote then return false end
    return fireRemote(remote, "PickCard")
end

local function pickCardWithRetry()
    for _ = 1, 3 do
        if sendPickCard() then return true end
        task.wait(1)
    end
    return false
end

local connections = {}
local function onConn(c) connections[#connections + 1] = c; return c end

local shooting    = false
local bihPlaced   = false
local lastTurnKey = nil

local queueState     = "LOBBY"
local stateChangedAt = os.clock()
local startupAt      = os.clock()
local lastInGameAt   = os.clock()
local lastActionAt   = os.clock()
local nextRematchAt  = 0
local nextQueueAt    = 0

setSpin(Config.SpinPreset)

onConn(RunService.Heartbeat:Connect(function()
    if aimAnim then
        local input = captured.Input
        if not input then
            aimAnim = nil
        else
            local a    = aimAnim
            local t    = math.clamp((os.clock() - a.t0) / a.dur, 0, 1)
            local ease = 1 - (1 - t) ^ 3
            local ang  = a.total * ease
            input.Direction = Vector2.new(
                math.cos(a.base + a.turn * ang),
                math.sin(a.base + a.turn * ang)
            )
            if t >= 1 then
                input.Direction = Vector2.new(
                    math.cos(a.base + a.turn * a.total),
                    math.sin(a.base + a.turn * a.total)
                )
                aimAnim = nil
            end
        end
    end

    if Config.AutoQueue then
        local currentlyInGame = isInGame()
        local elapsed = os.clock() - stateChangedAt
        local started = (os.clock() - startupAt) >= Config.StartupDelay

        if captured.InputAt and (os.clock() - captured.InputAt) < 1.0 then
            lastActionAt = os.clock()
        end

        if currentlyInGame then
            lastInGameAt   = os.clock()
            lastActionAt   = os.clock()
            nextRematchAt  = 0
            nextQueueAt    = 0
            if queueState ~= "IN_GAME" then
                queueState     = "IN_GAME"
                stateChangedAt = os.clock()
            end

        elseif not started then

        else
            if queueState == "IN_GAME" and (os.clock() - lastInGameAt) >= Config.EndGrace then
                captured.Input = nil
                captured.Rules = nil
                queueState     = "POST_MATCH"
                stateChangedAt = os.clock()

            elseif queueState == "POST_MATCH" and elapsed >= Config.PickCardDelay then
                task.spawn(pickCardWithRetry)
                queueState     = "PICKING_CARD"
                stateChangedAt = os.clock()

            elseif queueState == "PICKING_CARD" and elapsed >= Config.QueueDelay then
                queueState     = "LOBBY"
                stateChangedAt = os.clock()

            elseif queueState == "LOBBY" then
                local now     = os.clock()
                local idleFor = now - lastActionAt
                if now >= nextRematchAt then
                    task.spawn(sendRematch)
                    nextRematchAt = now + Config.RematchDelay
                end
                if idleFor >= Config.NoActionTimeout and now >= nextQueueAt then
                    task.spawn(sendQueue)
                    nextQueueAt = now + Config.RematchDelay
                end
            end
        end
    end

    local input = captured.Input
    if not input then return end

    local state = input.State
    local myTurn, matchState, mySeatId = isMyTurn()

    local turnKey = matchState
        and (tostring(matchState.ShotIndex) .. ":" .. tostring(matchState.Turn))
        or nil
    if turnKey ~= lastTurnKey then
        lastTurnKey = turnKey
        bihPlaced   = false
        if matchState and matchState.Turn == mySeatId then
            task.defer(function() Solver.compute(true) end)
        end
    end

    if state == "BallInHand" and Config.AutoPlaceBIH and not bihPlaced and myTurn then
        bihPlaced = true
        task.spawn(function()
            task.wait(0.2)
            if captured.Input and captured.Input.State == "BallInHand" then
                placeBest()
                task.wait(0.1)
                Solver.bestKey = nil
                Solver.compute(true)
            end
        end)
    end

    if Config.AutoPlay
        and myTurn
        and not shooting
        and (state == "Aiming" or (state == "BallInHand" and bihPlaced))
    then
        shooting = true
        local isBIH = (state == "BallInHand")

        task.spawn(function()
            task.wait(math.max(Config.AutoDelay or 0.6, 0.25))

            local curInput = captured.Input
            local curState = curInput and curInput.State
            if not (Config.AutoPlay and curInput
                and (curState == "Aiming" or (curState == "BallInHand" and isBIH))) then
                shooting = false; return
            end

            local best = Solver.compute(true)
            if best then
                if best.Ball and best.Ball.Number == 8 then
                    local spin = (curInput.Hud and curInput.Hud.Spin) or Vector2.zero
                    local res  = simulate(curInput.Simulation, best.Dir, best.Power, spin, best.Ball)
                    if not res or not res.TargetPotted or res.CuePotted then
                        shooting = false; return
                    end
                end

                aimSmooth(best.Dir, 0.28)
                local t0 = os.clock()
                while aimAnimating() and os.clock() - t0 < 1.0 do
                    task.wait(0.02)
                end
                task.wait(0.08)

                if captured.Input
                    and (captured.Input.State == "Aiming"
                        or (isBIH and captured.Input.State == "BallInHand")) then
                    fire(best.Dir, best.Power)
                end
            end

            releaseAim()
            shooting = false
        end)
    end
end))

local function makeLoader()
    return string.format(
        "pcall(function() "
        .. "if _G.is_poolgod_loaded and _G.is_poolgod_loaded() then return end "
        .. "_G.__POOLGOD_AUTOEXEC = true "
        .. "local f = loadstring or load; f(game:HttpGet(%q))() "
        .. "end)",
        Config.ScriptURL)
end

local function scheduleReExec()
    if not Config.AutoExecute then return false end
    if type(_G.__POOLGOD_AUTO) == "table" and _G.__POOLGOD_AUTO.ReExecQueued then
        return true
    end
    local loader = makeLoader()
    local queued = false
    if type(queue_on_teleport) == "function" then
        queued = pcall(queue_on_teleport, loader)
    end
    if not queued and type(queueonteleport) == "function" then
        queued = pcall(queueonteleport, loader)
    end
    if not queued then
        local syn = rawget(_G, "syn")
        if type(syn) == "table" and type(syn.queue_on_teleport) == "function" then
            queued = pcall(syn.queue_on_teleport, loader)
        end
    end
    if queued and type(_G.__POOLGOD_AUTO) == "table" then
        _G.__POOLGOD_AUTO.ReExecQueued = true
    end
    return queued
end

_G.__POOLGOD_AUTO = {
    Loaded       = true,
    LoadedAt     = os.clock(),
    ReExecQueued = false,
    Unload = function()
        for _, c in ipairs(connections) do
            if c and typeof(c) == "RBXScriptConnection" then c:Disconnect() end
        end
        table.clear(connections)
        uninstallHooks()
        Solver.best    = nil
        Solver.bestKey = nil
        shooting       = false
        aimAnim        = nil
        _G.__POOLGOD_AUTO = nil
    end,
    ReExec = scheduleReExec,
    IsLoaded = isPoolGodLoaded,
    Reload = function()
        local ok, err = pcall(function()
            local f = loadstring or load
            f(game:HttpGet(Config.ScriptURL))()
        end)
        return ok, err
    end,
    Status = function()
        return {
            QueueState = queueState,
            InGame     = isInGame(),
            Remote     = getPoolRemote(),
            AutoQueue  = Config.AutoQueue,
            AutoExecute = Config.AutoExecute,
            BestVenue  = selectBestVenue(),
            Venues     = scanVenues(),
        }
    end,
}

scheduleReExec()
